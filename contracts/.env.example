# ── GATTAI contracts — local environment ───────────────────────────────
# Salin file ini menjadi contracts/.env, lalu isi nilainya.
# contracts/.env sudah di-.gitignore; JANGAN commit file itu.
#
# `bun run --cwd contracts ...` memuat contracts/.env otomatis (Bun).
# TETAPI Hardhat 3 gagal untuk HTTP network saat dijalankan lewat Bun
# (undici interop). Untuk deploy ke testnet/mainnet, jalankan Hardhat lewat Node:
#   cd contracts
#   node --env-file=.env ../node_modules/hardhat/dist/src/cli.js <command>
# `npx hardhat ...` juga Node, tetapi TIDAK memuat .env otomatis.
#
# Jangan pernah menaruh private key mainnet di file ini.
# Untuk mainnet, gunakan keystore Hardhat:
#   npx hardhat keystore set MAINNET_DEPLOYER_PRIVATE_KEY

# ── Testnet (chain 46630) ──────────────────────────────────────────────
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Fallback hanya bila RPC resmi DNS-blocked:
# ROBINHOOD_RPC_URL=https://robinhood-sepolia-rpc.publicnode.com

# Deployer testnet (burner, bukan owner Safe).
# Boleh di .env lokal untuk testnet; jangan dipakai untuk mainnet.
DEPLOYER_PRIVATE_KEY=

# ── Mainnet (chain 4663) ───────────────────────────────────────────────
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# JANGAN isi key mainnet di sini. Gunakan keystore:
#   npx hardhat keystore set MAINNET_DEPLOYER_PRIVATE_KEY
# MAINNET_DEPLOYER_PRIVATE_KEY=

# Safe mainnet yang dibuat lewat Safe web app. Dipakai oleh
# `bun run --cwd contracts import:safe:mainnet` (read-only, tidak membuat Safe).
# SAFE_ADDRESS=

# ── Alamat & verifikasi Phase 1 ────────────────────────────────────────
# Testnet: isi setelah Safe + MockUSDG + DepositManager deploy.
# Mainnet: isi setelah Safe + DepositManager mainnet deploy.
# TREASURY_ADDRESS=
# TESTNET: alamat MockUSDG hasil deploy.
# MAINNET: 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# USDG_TOKEN_ADDRESS=
USDG_DECIMALS=6

# ── Preflight mainnet (read-only) ──────────────────────────────────────
# PREFLIGHT_DEPLOYER_ADDRESS=
# PREFLIGHT_MIN_BALANCE_ETH=0.001
# PREFLIGHT_MIN_SAFE_OWNERS=3
# PREFLIGHT_MIN_SAFE_THRESHOLD=2
# PREFLIGHT_MAX_DEPOSIT_USDG=100
# PREFLIGHT_ALLOW_DIRTY=1   # lokal saja; JANGAN dipakai saat deploy

# ── Fork test ──────────────────────────────────────────────────────────
# FORK_BLOCK_NUMBER=
# FORK_USDG_HOLDER=0x9f736f87e6293ac1bd9142e257dbfac8b7acf1ae

# ── Guard deploy mainnet ───────────────────────────────────────────────
# JANGAN simpan di .env. Set manual di shell hanya saat deploy:
#   $env:CONFIRM_MAINNET_DEPLOY = "4663"
# CONFIRM_MAINNET_DEPLOY=
