POSTGRES_PASSWORD=ganti-dengan-password-kuat

NODE_ENV=production
PORT=3000
CHAIN_ID=4663

DATABASE_URL=postgres://gattai:ganti-dengan-password-kuat@db:5432/gattai

FRONTEND_URL=https://www.gattai.tech,https://gattai.tech
SIWE_DOMAIN=www.gattai.tech,gattai.tech
SESSION_SECRET=ganti-dengan-openssl-rand-hex-32

# Share run / OG. PUBLIC_BASE_URL wajib origin kanonis (bukan localhost).
PUBLIC_BASE_URL=https://www.gattai.tech
FRONTEND_DIST_DIR=/srv/gattai
MEDIA_SHARE_ENABLED=false
# Wallet tambahan yang dikecualikan dari /leaderboard (opsional, pisah koma).
LEADERBOARD_EXCLUDED_WALLETS=

# Holder runs: biarkan false untuk deploy pertama. Untuk mengaktifkan setelah
# soak worker snapshot lulus: ubah ke true, lalu jalankan
# `ENABLE_HOLDER=1 ./deploy.sh` (flag itu hanya guard, bukan switch).
HOLDER_RUNS_ENABLED=false
# Token resmi Pons $GATTAI (mainnet). Default backend juga alamat ini.
HOLDER_TOKEN_ADDRESS=0x863019e2e676164fcfaab6e14dcd6568eb6deb1f
# Kedalaman konfirmasi snapshot holder. Produksi minimal 12; default 60.
HOLDER_SNAPSHOT_CONFIRMATIONS=60
# Retensi snapshot holder (hari) dan jumlah snapshot terbaru yang selalu disimpan.
HOLDER_SNAPSHOT_RETENTION_DAYS=90
HOLDER_SNAPSHOT_RETENTION_MIN_PER_WALLET=10

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL_FALLBACKS=

