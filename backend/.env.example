# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://<username>:<password>@localhost:5432/<your-database-name>

# Database uji (opsional). Default: DATABASE_URL dengan sufiks "_test".
# Dipakai otomatis oleh `bun test` (schema di-reset tiap kali test berjalan).
# TEST_DATABASE_URL=postgres://<username>:<password>@localhost:5432/<your-database-name>_test

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Origin frontend yang diizinkan (CORS + penjaga CSRF), dipisah koma.
# Produksi: WAJIB diisi dengan origin final dan TANPA "*" — server gagal saat
# boot bila NODE_ENV=production dan nilainya kosong atau memuat "*".
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# ── Sesi & kriptografi ──────────────────────────────────────────────────────
# Dipakai untuk menandatangani cookie sesi SIWE (dan `sid` tabel `sessions`).
# WAJIB di produksi: minimal 32 karakter dan BUKAN nilai contoh ini. Server
# gagal saat boot bila NODE_ENV=production dan nilainya kosong/pendek/contoh.
# Buat dengan:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Host yang boleh menandatangani login SIWE, dipisah koma. Harus sama dengan
# host tempat user membuka frontend (`window.location.host`), mis. "localhost:5173"
# — tulis hostnya, bukan origin (skema "https://" opsional, port ikut bila ada).
# Kosongkan bila ingin mengikuti `FRONTEND_URL` di atas (biasanya sama).
# Produksi: TANPA "*" — server gagal saat boot bila kosong atau memuat "*"
# (wildcard berarti domain penyerang pun boleh memakai nonce kita).
SIWE_DOMAIN=localhost:5173,localhost:5174

# ── Provider AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Override base URL provider (opsional). Berguna untuk mengarahkan ke mock server
# lokal tanpa API key asli: jalankan `bun run mock:providers` lalu set ketiganya
# ke http://localhost:4319.
# ANTHROPIC_API_URL=https://api.anthropic.com
# OPENAI_API_URL=https://api.openai.com
# PERPLEXITY_API_URL=https://api.perplexity.ai

# Ketahanan panggilan provider (retry + timeout) untuk semua adapter.
# PROVIDER_RETRY_ATTEMPTS=3
# PROVIDER_TIMEOUT_MS=120000

# Plafon biaya per request/run (pengaman terhadap prompt raksasa).
# MAX_REQUEST_CHARS=200000
# MAX_OUTPUT_TOKENS_PER_STEP=4096
# MAX_PROVIDER_COST_USD_PER_RUN=5

# Kuota trial (override `backend/config/params.yaml`).
# Default repo: 10 run teks / 30 percobaan / 0 media gratis.
# Produksi menolak TRIAL_FREE_MEDIA_ATTEMPTS > 0.
# TRIAL_FREE_RUNS=10
# TRIAL_MAX_ATTEMPTS=30
# TRIAL_FREE_MEDIA_ATTEMPTS=0

# Holder tiers (Fase 5). Kill switch + override interval worker snapshot
# dan plafon anggaran harian tanpa mengubah `params.yaml`.
# HOLDER_RUNS_ENABLED=true
# HOLDER_SNAPSHOT_INTERVAL_HOURS=24
# HOLDER_DAILY_BUDGET_USD=50
# Token snapshot holder; terpisah dari BURN_TOKEN_ADDRESS.
# HOLDER_TOKEN_ADDRESS=0x863019e2e676164fcfaab6e14dcd6568eb6deb1f
# Timeout RPC khusus holder (ms); lebih pendek dari RPC_TIMEOUT_MS.
# HOLDER_RPC_TIMEOUT_MS=3000
# Batas RPC paralel (1-20) dan jitter interval (0-0.5). Default aman:
# 5 dan 0.1. Jangan naikkan konkurensi tanpa memantau rate limit RPC.
# HOLDER_SNAPSHOT_CONCURRENCY=5
# HOLDER_SNAPSHOT_BATCH_SIZE=500
# HOLDER_SNAPSHOT_JITTER_RATIO=0.1
# Kedalaman blok terkonfirmasi untuk snapshot. Default 60; produksi minimal 12.
# HOLDER_SNAPSHOT_CONFIRMATIONS=60
# Retensi snapshot: hapus baris > N hari, tetapi simpan minimal N terbaru/wallet.
# HOLDER_SNAPSHOT_RETENTION_DAYS=90
# HOLDER_SNAPSHOT_RETENTION_MIN_PER_WALLET=10
#
# KHUSUS STAGING/VERIFIKASI CEPAT — JANGAN SET DI PRODUCTION.
# Produksi menolak kedua variabel ini lewat `assertProductionConfig`.
# HOLDER_SNAPSHOT_INTERVAL_MINUTES=2
# HOLDER_TIER_MIN_GAP_MINUTES=1

# Higgsfield (lapisan media). HIGGSFIELD_API_URL bisa diganti bila endpoint resmi berbeda.
# Key ini adalah sakelar formasi media: tanpa key, Visual/Video/Launch Kit tampil
# sebagai "coming soon" di UI dan ditolak `503` di API (lihat
# `backend/src/orchestration/availability.ts`). Mengisinya langsung
# mengaktifkan ketiganya — tanpa deploy ulang, tanpa ubah config.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai

# MIMO Token Plan (E2E teks). Key diawali tp-/ttp-; base URL eksklusif dari
# halaman Token Plan dan HARUS cocok dengan region key (CN vs SGP).
# Key proyek ini adalah region SGP; memakai URL CN akan dibalas 401.
# JANGAN commit key asli ke Git — isi hanya di backend/.env lokal.
MIMO_API_KEY=
MIMO_API_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# ── Onchain (Fase 2: deposit indexer) ───────────────────────────────────────
# TESTNET (chain id 46630)
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# CHAIN_ID=46630
#
# MAINNET (chain id 4663). Untuk deployment mainnet, ganti blok di bawah dan
# JANGAN mencampur DB/API key testnet dengan mainnet.
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# CHAIN_ID=4663
# NODE_ENV=production

# Alamat kontrak (kosong sampai kontrak di-deploy).
GATTAI_TOKEN_ADDRESS=
DEPOSIT_MANAGER_ADDRESS=
# TESTNET: alamat Mock USDG hasil deploy (bukan alamat mainnet).
# MAINNET: 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Verifikasi alamat + decimals() onchain sebelum deploy.
USDG_TOKEN_ADDRESS=
# Desimal token USDG (default 6).
# USDG_DECIMALS=6
# Alamat treasury (Safe multisig di mainnet, EOA di testnet).
TREASURY_ADDRESS=

# Aset top-up yang aktif. Produksi default USDG-only bila kosong.
# Fase 1: USDG. Fase 2: tambahkan ETH setelah feed harga siap.
# Fase 3: tambahkan GATTAI setelah pool TWAP + likuiditas siap.
# DEPOSIT_ENABLED_SYMBOLS=USDG

# Sumber harga (fail-closed bila kosong). Chainlink ETH/USD & pool Uniswap V3 GATTAI.
CHAINLINK_ETH_USD_FEED=
GATTAI_TWAP_POOL=

# Harga manual (USD) — offchain, DIMATIKAN secara default. Hanya dipakai bila
# diisi dan (bukan produksi ATAU ALLOW_MANUAL_PRICES=true). Untuk testnet tanpa feed.
ETH_USD_PRICE=
GATTAI_USD_PRICE=
# ALLOW_MANUAL_PRICES=false

# Indexer deposit.
# Testnet boleh 1–3; produksi mainnet wajib >= 60.
# DEPOSIT_CONFIRMATIONS=60
# MAINNET: wajib = block deployment DepositManager (bukan 0, bukan head).
# INDEXER_FROM_BLOCK=0
# INDEXER_ENABLED=true
# INDEXER_POLL_INTERVAL_MS=15000
# INDEXER_BATCH_BLOCKS=2000
# Wajib lebih besar dari DEPOSIT_CONFIRMATIONS di produksi.
# INDEXER_REORG_LOOKBACK=256

# Umur run non-terminal sebelum dianggap yatim dan di-reap saat boot (ms).
# Default 1800000 = 30 menit. Reservasi run yatim dilepas; SSE langsung selesai.
# RUN_STALE_AFTER_MS=1800000
# Umur estimasi AWAITING_CONFIRMATION sebelum kedaluwarsa (ms). Default 24 jam.
# RUN_CONFIRM_EXPIRY_MS=86400000

# Rate limiting (fixed window, in-memory, single-instance).
# Jendela (ms), maksimum per IP, maksimum pembuatan run per project.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_IP_PER_MIN=600
# RATE_LIMIT_RUNS_PER_MIN=120

# Jumlah hop proxy terpercaya di depan API (untuk menafsirkan X-Forwarded-For
# dari KANAN; entri paling kiri bisa dipalsukan klien). Railway = 1.
# TRUSTED_PROXY_HOPS=1

# ── Burn (Fase 3: epoch buyback & burn) ─────────────────────────────────────
# Durasi satu epoch (jam). Default 168 = mingguan.
# BURN_EPOCH_HOURS=168
# Awal epoch pertama (ISO 8601); window di-tile dari sini.
# BURN_GENESIS=2026-01-01T00:00:00Z
# Selang polling worker burn (ms) saat --live.
# BURN_POLL_INTERVAL_MS=3600000
# Eksekusi burn onchain otomatis (treasury EOA). Default false = dry-run:
# worker hanya mencatat epoch `pending`; eksekusi via treasury multisig lalu
# catat dengan `bun run --cwd backend burn --mark-executed ...`.
# BURN_EXECUTE=false
# Kunci privat treasury (hanya bila BURN_EXECUTE=true).
# BURN_TREASURY_PRIVATE_KEY=

# ── Burn indexer (Fase 1: /burns) ──────────────────────────────────────────
# Token resmi $GATTAI yang diindeks. Terpisah dari GATTAI_TOKEN_ADDRESS
# (deposit tetap USDG-only di Phase 1).
# BURN_TOKEN_ADDRESS=0x863019e2e676164fcfaab6e14dcd6568eb6deb1f
# BURN_TOKEN_SYMBOL=GATTAI
# BURN_TOKEN_DECIMALS=18
# Total supply base-unit (default 1e9 token). Isi eksplisit bila berbeda.
# BURN_TOKEN_TOTAL_SUPPLY=1000000000000000000000000000
# Blok mint/launch token; wajib untuk backfill mainnet.
# BURN_INDEXER_FROM_BLOCK=96177892
# Mainnet wajib >= 60.
# BURN_CONFIRMATIONS=60
# BURN_INDEXER_ENABLED=true
# BURN_INDEXER_POLL_INTERVAL_MS=15000
# BURN_INDEXER_BATCH_BLOCKS=2000
# BURN_INDEXER_REORG_LOOKBACK=128
# Wallet tim/treasury (dipisah koma) yang transfernya diklasifikasikan `team`.
# TEAM_BURN_WALLETS=0xca39f6f2aff53659e072da95537ba2f818a6890a
# Alamat dead/burn (default 0x…dEaD).
# BURN_DEAD_ADDRESSES=0x000000000000000000000000000000000000dEaD

# ── Share run / OG (Fase 2) ──────────────────────────────────────────────
# Origin kanonis untuk tautan share dan meta absolut. Kosong = origin request
# (cukup untuk dev, JANGAN biarkan kosong di produksi di balik proxy).
# PUBLIC_BASE_URL=https://www.gattai.tech
# Folder berisi index.html hasil build frontend (marker SEO_META_START/END).
# Di Docker compose volume di-mount ke /srv/gattai.
# FRONTEND_DIST_DIR=../frontend/dist
# Gate output media di /run/:slug. Default false sampai moderasi tersedia.
# MEDIA_SHARE_ENABLED=false

# ── Leaderboard (Fase 5) ─────────────────────────────────────────────────
# Wallet tambahan yang tidak boleh muncul di /leaderboard (kontrak internal,
# akun operasional). Tim/treasury dari TEAM_BURN_WALLETS/TREASURY_ADDRESS
# sudah otomatis dikecualikan. Pisahkan dengan koma.
# LEADERBOARD_EXCLUDED_WALLETS=
