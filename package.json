{
  "name": "web3-starter",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "contracts"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "typecheck": "bun run --cwd frontend typecheck && bun run --cwd backend typecheck && bun run --cwd contracts typecheck",
    "lint": "bun run --cwd frontend lint && bun run --cwd backend lint",
    "test": "bun run --cwd backend test && bun run --cwd frontend test",
    "test:backend": "bun run --cwd backend test",
    "test:frontend": "bun run --cwd frontend test",
    "contracts:build": "bun run --cwd contracts build",
    "contracts:test": "bun run --cwd contracts test",
    "contracts:test:fork": "bun run --cwd contracts test:fork",
    "contracts:deploy": "bun run --cwd contracts deploy",
    "contracts:deploy:testnet": "bun run --cwd contracts deploy:testnet",
    "contracts:import:safe:mainnet": "bun run --cwd contracts import:safe:mainnet",
    "contracts:preflight:mainnet": "bun run --cwd contracts preflight:mainnet",
    "contracts:deploy:phase1:mainnet:guarded": "bun run --cwd contracts deploy:phase1:mainnet:guarded",
    "contracts:manifest:mainnet": "bun run --cwd contracts manifest:mainnet",
    "contracts:manifest:testnet": "bun run --cwd contracts manifest:testnet",
    "sync": "node scripts/sync-contracts.mjs"
  }
}
